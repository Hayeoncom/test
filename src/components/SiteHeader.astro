---
const { compact = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--compact': compact }]}>
  <a href="/" aria-label="Hayeon home">Hayeon.jpg</a>
</header>

<style>
  .site-header {
    padding: 90px 0 100px;
    text-align: center;
    font-family: "Epilogue", sans-serif;
    font-size: 65px;
    font-weight: 100;
  }

  .site-header--compact {
    padding: 34px 0 18px;
    font-size: 28px;
  }

  @media (max-width: 720px) {
    .site-header {
      padding: 56px 0 64px;
      font-size: 42px;
    }

    .site-header--compact {
      padding: 24px 0 12px;
      font-size: 24px;
    }
  }
</style>
