---
const { entry, item } = Astro.props;
const source = item ?? entry.data;
const { id, title, date, thumbnail } = source;
const href = source.href ?? `/travel/${id}/`;
const displayDate = source.displayDate ?? date;
const isPlaceholder = source.isPlaceholder ?? source.status === 'placeholder';
---

<a class="travel-card" href={href}>
  <span class="travel-card__media">
    <img src={thumbnail} alt={title} loading="lazy" />
    {isPlaceholder && <span class="travel-card__badge">Soon</span>}
  </span>
  <span>{title}</span>
  <p>{displayDate}</p>
</a>

<style>
  .travel-card {
    display: block;
    width: 350px;
    max-width: calc(100% - 36px);
    margin: 0 auto;
  }

  .travel-card__media {
    position: relative;
    display: block;
    width: 350px;
    max-width: 100%;
  }

  .travel-card img {
    width: 350px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: border-radius 160ms ease;
  }

  .travel-card__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.86);
    padding: 5px 10px 6px;
    color: #333;
    font-family: "Nunito Sans", sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1;
  }

  .travel-card:hover img {
    border-radius: 50%;
  }

  .travel-card span {
    display: block;
    margin-top: 10px;
    font-family: Georgia, serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .travel-card p {
    margin-top: 10px;
    color: #808080;
    font-family: "Nunito Sans", sans-serif;
    font-size: 18px;
    font-weight: 300;
  }
</style>
