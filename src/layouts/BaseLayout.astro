---
import '../styles/base.css';
import '../styles/responsive.css';

const {
  title = 'Hayeon',
  description = 'Travel and photography by Hayeon'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@100&family=Jost:ital,wght@0,400;1,200&family=Noto+Sans+KR:wght@100;300&family=Nunito+Sans:wght@300;400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
