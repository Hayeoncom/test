---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import '../styles/travel.css';

const { entry } = Astro.props;
const { title, music, musicTitle } = entry.data;
const { contentState = 'content' } = Astro.props;
---

<BaseLayout title={title}>
  <main class:list={['travel-shell', `travel-shell--${contentState}`]}>
    <SiteHeader compact />
    {music && <AudioPlayer src={music} title={musicTitle} />}
    <article class:list={['travel-content', `travel-content--${contentState}`]}>
      <slot />
    </article>
  </main>
</BaseLayout>
