---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TravelCard from '../components/TravelCard.astro';
import PhotographyCard from '../components/PhotographyCard.astro';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const travelEntries = (await getCollection('travel'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.date.localeCompare(b.data.date));

const photographyEntries = (await getCollection('photography'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.date.localeCompare(b.data.date));

const travelEntryById = new Map(travelEntries.map((entry) => [entry.data.id, entry]));
const migratedTravelIds = ['2018-osaka', '2018-tokyo', '2019-fukuoka', '2019-hongkong-macau', '2019-tokyo'];
const migratedTravelCards = migratedTravelIds
  .map((id) => travelEntryById.get(id))
  .filter(Boolean)
  .map((entry) => ({ type: 'entry', entry }));

const legacyTravelCards = [
  {
    title: 'New yorrrk',
    displayDate: '#02, 2020',
    thumbnail: '/nyc.jpg',
    href: '/new york.html'
  },
  {
    title: 'Christmas in London',
    displayDate: '#12, 2022',
    thumbnail: '/IMG_0868.jpeg',
    href: '/london.html'
  },
  {
    title: 'Tokyo again🌸',
    displayDate: '#03, 2023',
    thumbnail: '/t_a_11.jpeg',
    href: '/tokyoagain.html'
  },
  {
    title: 'NA-GO-YA🎡',
    displayDate: '#10, 2023',
    thumbnail: '/23nagoya.jpeg',
    href: '/tokyoagain.html'
  },
  {
    title: 'Haru no KOBE',
    displayDate: '#03, 2025',
    thumbnail: '/25kobe.jpeg',
    href: '/tokyoagain.html'
  },
  {
    title: 'KYOTO',
    displayDate: '#06, 2025',
    thumbnail: '/kyoto.jpeg',
    href: '/tokyoagain.html'
  },
  {
    title: 'TOKYO(ˆ◝ ·̫ ◜ˆ)˶ෆ',
    displayDate: '#10, 2025',
    thumbnail: '/25tokyo.jpeg',
    href: '/tokyoagain.html'
  },
  {
    title: '🌴bali🐟',
    displayDate: '#02, 2026',
    thumbnail: '/what.png',
    href: '/tokyoagain.html'
  },
  {
    title: 'NAGOYA-ㅅ-letsGinny~',
    displayDate: '#06, 2026',
    thumbnail: '/what.png',
    href: '/tokyoagain.html'
  }
].map((item) => ({ type: 'legacy', item }));

const travelCards = [...migratedTravelCards, ...legacyTravelCards];

const photographyOrder = ['2019-tokyo', '2019-hongkong', '2020-newyork', '2022-london', '2023-tokyo'];
const photographyEntryById = new Map(photographyEntries.map((entry) => [entry.data.id, entry]));
const orderedPhotographyEntries = photographyOrder
  .map((id) => photographyEntryById.get(id))
  .filter(Boolean);

const slideImages = [
  'j3.JPG',
  'j5.JPG',
  'j6.JPG',
  'j8.JPG',
  'j9.JPG',
  'j10.JPG',
  'j11.JPG',
  'j13.JPG',
  'n1.JPG',
  'n2.JPG',
  'n6.JPG',
  'n7.JPG',
  'n8.JPG',
  'n3.JPG',
  'n10.JPG',
  'n11.JPG'
];

const formatHomeDate = (date) => {
  const [year, month] = date.split('-');
  return `#${month}, ${year}`;
};
---

<BaseLayout title="Hayeon">
  <main class="home-wrap">
    <h1 class="home-title">Hayeon.jpg</h1>
    <section class="home-slider" aria-label="Featured photographs">
      <div class="home-slider__track">
        {slideImages.map((src, index) => (
          <div class="home-slider__slide">
            <img src={`/${src}`} alt={`${index + 1}`} />
          </div>
        ))}
      </div>
    </section>
    <section class="home-section-marker" aria-label="Travel">🛸</section>
    <section class="travel-grid" aria-label="Travel entries">
      {travelCards.map((card) => (
        card.type === 'entry'
          ? <TravelCard entry={card.entry} item={{ ...card.entry.data, displayDate: formatHomeDate(card.entry.data.date) }} />
          : <TravelCard item={card.item} />
      ))}
    </section>
    <section class="home-section-marker" aria-label="Photography">📸</section>
    <section class="photography-list" aria-label="Photography entries">
      {orderedPhotographyEntries.map((entry) => <PhotographyCard entry={entry} />)}
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
