---
import { getCollection, render } from 'astro:content';
import TravelLayout from '../../layouts/TravelLayout.astro';
import { getTravelContentState, isVisibleTravelEntry } from '../../utils/travelContent';

export async function getStaticPaths() {
  const entries = await getCollection('travel');

  return entries
    .filter(isVisibleTravelEntry)
    .map((entry) => ({
      params: { id: entry.data.id },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const contentState = getTravelContentState(entry);
---

<TravelLayout entry={entry} contentState={contentState}>
  <Content />
</TravelLayout>
